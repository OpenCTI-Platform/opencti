# Build context of every image is the repository root (Yarn and uv workspaces).
# Only what the Dockerfiles copy is kept in the context.
*

# Yarn workspace
!.yarnrc.yml
!package.json
!yarn.lock
!patch
!opencti-platform/eslint-plugin-custom-rules/package.json
!opencti-platform/opencti-front
!opencti-platform/opencti-graphql

# uv workspace
!pyproject.toml
!uv.lock
!client-python/pyproject.toml
!client-python/README.md
!client-python/pycti
!opencti-worker/pyproject.toml
!opencti-worker/src

# never sent to the daemon, whatever the rules above
**/node_modules
**/dist
**/build
**/coverage
**/.idea
**/.env
**/.eslintcache
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/__generated__
**/__pycache__
**/*.py[cod]
**/.venv
**/.ruff_cache
**/.mypy_cache
**/.pytest_cache
opencti-platform/opencti-front/config/development.json
opencti-platform/opencti-front/.DS_Store
opencti-platform/opencti-front/.env.local
opencti-platform/opencti-front/.env.development.local
opencti-platform/opencti-front/.env.test.local
opencti-platform/opencti-front/.env.production.local
opencti-platform/opencti-graphql/config/development.json
opencti-platform/opencti-graphql/config/production.json
opencti-platform/opencti-graphql/config/local.json
opencti-platform/opencti-graphql/logs
