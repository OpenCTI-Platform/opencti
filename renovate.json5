{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':semanticCommits',
  ],
  labels: [
    'dependencies',
    'filigran team',
  ],
  minimumReleaseAge: '3 days',
  // high limits so that all PRs are created at once during the schedule window rather than being drip-fed across multiple runs
  prHourlyLimit: 100,
  prConcurrentLimit: 100,
  branchConcurrentLimit: 100,
  timezone: 'Europe/Paris',
  // weekdays outside working hours (22h-5h) + all weekend
  schedule: [
    '* 0-4,22-23 * * 1-5',
    '* * * * 0,6',
  ],
  // prevent Renovate from updating existing PRs outside the schedule window
  updateNotScheduled: false,
  // only rebase when there is a conflict; avoids unnecessary CI runs on every base branch change, can be removed when number of open PR is low
  rebaseWhen: 'conflicted',
  vulnerabilityAlerts: {
    // as we don't rely on Renovate to be informed of dependency security advisories,
    // vulnerabilityAlerts is disabled since it can cause problems by skipping minimumReleaseAge, schedule and others constraints
    enabled: false,
  },
  packageRules: [
    // sticks to Node 22.x, matching engines.node (>= 22.0.0)
    {
      matchDepNames: [
        'node',
        'cimg/node',
      ],
      allowedVersions: '<23',
      description: 'Keep Node.js docker images and setup-node at version 22.x',
    },
    {
      matchDepNames: [
        '@types/node',
      ],
      allowedVersions: '<23',
      description: 'Keep @types/node at version 22.x, matching engines.node',
    },
    {
      matchDepNames: [
        'python',
        'cimg/python',
      ],
      allowedVersions: '<3.13',
      description: 'Keep Python docker images and setup-python at version 3.12.x',
    },
    {
      matchPackageNames: [
        'elasticsearch',
        'kibana',
        '@elastic/elasticsearch',
      ],
      allowedVersions: '<9',
      description: 'Keep Elasticsearch, Kibana and the Elasticsearch client at version 8.x',
    },
    {
      matchPackageNames: [
        'opensearchproject/opensearch',
        'opensearchproject/opensearch-dashboards',
      ],
      allowedVersions: '<3.8',
      description: 'Keep OpenSearch and OpenSearch Dashboards docker images at version 3.7.x',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'redis',
      ],
      allowedVersions: '<8.7',
      description: 'Keep redis docker image at version 8.6.x',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'rabbitmq',
      ],
      allowedVersions: '<4.4',
      description: 'Keep rabbitmq docker image at version 4.3.x',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'pgsty/silo',
      ],
      versioning: 'regex:^RELEASE\\.(?<patch>\\d{4})-(?<build>\\d{2})-(?<revision>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z$',
      description: 'Read the date-based RELEASE tags of the silo docker image as patch versions',
    },
    // sticks to MIT version of apexcharts
    {
      matchDepNames: [
        'apexcharts'
      ],
      allowedVersions: '<5',
      description: 'Keep apexcharts at version 4.x',
    },
    {
      matchDepNames: [
        'react-apexcharts'
      ],
      allowedVersions: '<1.8',
      description: 'Keep react-apexcharts before 1.8',
    },

    // openid-clientv5 is an aliased+patched dependency pinned to openid-client@5.7.1.
    // Its jose resolution is also pinned. Disable all Renovate updates for both.
    {
      matchDepNames: [
        'openid-clientv5',
      ],
      matchUpdateTypes: [
        'major'
      ],
      enabled: false,
      description: 'Do not update openid-clientv5 (aliased and patched, pinned to v5)',
    },
    {
      matchPackageNames: [
        'jose',
      ],
      matchDepTypes: [
        'resolutions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
      description: 'Do not update openid-clientv5/jose resolution to major versions',
    },
    {
      description: 'Disable updates of images intentionally pinned to older versions for compatibility testing',
      matchFileNames: [
        '.drone.yml',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'python',
      ],
      matchCurrentVersion: '<=3.12',
      enabled: false,
    },
    // aws-sdk-js-v3 is too frequently updated, so we update it only once a week on Sunday
    {
      extends: [
        'monorepo:aws-sdk-js-v3',
      ],
      description: 'Update aws-sdk-js-v3 only once a week on Sunday',
      schedule: ['* * * * 0'],
    },
    // group non-major devDependencies and GitHub Actions once a week to avoid Renovate noise
    {
      groupName: 'devDependencies (non-major)',
      groupSlug: 'dev-dependencies-non-major',
      description: 'Batch non-major updates of dev dependencies and GitHub Actions once a week on Sunday',
      schedule: [
        '* * * * 0',
      ],
      matchDepTypes: [
        'devDependencies',
        'action',
        // Python: PEP 735 dependency groups and build backend are development tooling
        'dependency-groups',
        'build-system.requires',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      // use 'auto' here so grouped PRs stay up-to-date automatically,
      // since we batch them and want them merge-ready on Monday
      rebaseWhen: 'auto',
    },
    {
      groupName: 'devDependencies (non-major)',
      groupSlug: 'dev-dependencies-non-major',
      description: 'Batch non-major updates of the development tooling docker images with the dev dependencies once a week on Sunday',
      schedule: [
        '* * * * 0',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'redislabs/redisinsight',
        'grafana/pyroscope',
        'jaegertracing/all-in-one',
        'otel/opentelemetry-collector-contrib',
        'prom/prometheus',
        'grafana/grafana',
        'keycloak/keycloak',
        'mokapi/mokapi',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      rebaseWhen: 'auto',
    },
    // every uv of the repository (Docker images, CircleCI, GitHub Actions, Read the Docs) moves in one PR,
    // with setup-uv, which verifies the checksum of the uv it downloads only for the uv versions it knows
    {
      groupName: 'uv',
      matchPackageNames: [
        'astral-sh/setup-uv',
        'astral-sh/uv',
        'ghcr.io/astral-sh/uv',
      ],
    },
    // Python: in-range updates of direct dependencies get a dedicated lockfile-only PR, out-of-range updates replace the constraint
    {
      matchManagers: ['pep621'],
      rangeStrategy: 'update-lockfile',
    },
  ],
  // uv versions that no built-in manager tracks (the docker manager tracks ghcr.io/astral-sh/uv, the github-actions manager the version input of setup-uv)
  customManagers: [
    {
      customType: 'regex',
      // the checksum is the SHA-256 of a release asset, which the github-release-attachments datasource updates with the version
      description: 'uv installed by scripts/ci/install-uv.sh on CircleCI and Read the Docs',
      managerFilePatterns: [
        '/^scripts/ci/install-uv\\.sh$/',
      ],
      matchStrings: [
        'UV_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s+UV_SHA256=(?<currentDigest>[a-f0-9]{64})',
      ],
      depNameTemplate: 'astral-sh/uv',
      datasourceTemplate: 'github-release-attachments',
    },
  ],
  // do lock file maintenance once a week on Sunday
  lockFileMaintenance: {
    schedule: [
      '* * * * 0',
    ],
    rebaseWhen: 'auto',
    enabled: true,
  },
}
