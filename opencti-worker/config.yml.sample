---
opencti:
  url: 'http://localhost:8080'
  token: 'ChangeMe'
  json_logging: true

worker:
  log_level: 'info'
  telemetry_enabled: false
  objects_max_refs: 0
  # Proposal D v1 - opt-in leaf-only batching of dependency-free STIX objects into a
  # single stixObjectsBatchImport mutation call. Disabled by default; enable to A/B
  # test against the per-item import path.
  batch_import_enabled: false
  batch_import_size: 50
  batch_import_timeout: 1.0