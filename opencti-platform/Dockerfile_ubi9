# syntax=docker/dockerfile:1.27
# Built from the repository root: docker build -f opencti-platform/Dockerfile_ubi9 .
FROM registry.access.redhat.com/ubi9/ubi AS base

ARG PYTHON_VERSION=3.12

##############################
### Build builder
##############################

FROM base AS builder

# For layer optimisation, start by installing resources not dependant from source code
RUN <<EOT
  set -euxo pipefail

  dnf -y module enable nodejs:22
  dnf -y --setopt=install_weak_deps=0 install nodejs python${PYTHON_VERSION} python${PYTHON_VERSION}-devel gcc-c++ make git-core
  dnf clean all
  ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm
  alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 2
  alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip${PYTHON_VERSION} 2
  alternatives --install /usr/bin/python3-config python3-config /usr/bin/python${PYTHON_VERSION}-config 2
  npm install -g corepack
EOT

WORKDIR /opt/opencti

# Yarn workspace metadata: this layer is only invalidated when a manifest, a patch or the
# lockfile changes. The lockfile lives at the repository root, hence the root build context.
COPY .yarnrc.yml package.json yarn.lock ./
COPY opencti-platform/eslint-plugin-custom-rules/package.json ./opencti-platform/eslint-plugin-custom-rules/
COPY opencti-platform/opencti-front/package.json ./opencti-platform/opencti-front/
COPY opencti-platform/opencti-front/patch/ ./opencti-platform/opencti-front/patch/
COPY opencti-platform/opencti-graphql/package.json ./opencti-platform/opencti-graphql/
COPY opencti-platform/opencti-graphql/patch/ ./opencti-platform/opencti-graphql/patch/

# an install must never rewrite the committed lockfile
ENV YARN_ENABLE_IMMUTABLE_INSTALLS="true"


##############################
### Build back
##############################

FROM builder AS builder-back

# TAG_VERSION used to generate connector manifest on a tag during yarn build. Default to rolling manifest
ARG TAG_VERSION
ENV TAG_VERSION="${TAG_VERSION}"

# only the dependencies of this workspace, not the whole monorepo
RUN yarn workspaces focus opencti-graphql

WORKDIR /opt/opencti/opencti-platform/opencti-graphql

# Copy all remaining sources
COPY opencti-platform/opencti-graphql/ ./
RUN yarn build:prod

##############################
### Build front
##############################

FROM builder AS builder-front
RUN yarn workspaces focus opencti-front

WORKDIR /opt/opencti/opencti-platform/opencti-front

# Copy all remaining sources and build
COPY opencti-platform/opencti-front/ ./
RUN yarn build

##############################
### Build production image
##############################

FROM base AS app

RUN <<EOT
  set -euxo pipefail

  curl -L -o /sbin/tini https://github.com/krallin/tini/releases/download/v0.19.0/tini
  echo "93dcc18adc78c65a028a84799ecf8ad40c936fdfc5f2a57b1acda5a8117fa82c /sbin/tini" | sha256sum -c -
  chmod +x /sbin/tini

  dnf -y module enable nodejs:22
  dnf -y --setopt=install_weak_deps=0 install nodejs python${PYTHON_VERSION} python${PYTHON_VERSION}-devel
  alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 2
  alternatives --install /usr/bin/python3-config python3-config /usr/bin/python${PYTHON_VERSION}-config 2
  dnf clean all
EOT

RUN --mount=type=bind,source=opencti-platform/opencti-graphql/src/python/requirements.txt,target=/opt/opencti/src/python/requirements.txt <<EOT
  set -euxo pipefail

  dnf -y --setopt=install_weak_deps=0 install python${PYTHON_VERSION}-pip git-core
  pip${PYTHON_VERSION} install --no-cache-dir --requirement /opt/opencti/src/python/requirements.txt
  dnf -y remove python${PYTHON_VERSION}-pip git-core
  dnf clean all
EOT

WORKDIR /opt/opencti

COPY --from=builder-back /opt/opencti/opencti-platform/opencti-graphql/build/ ./build/
COPY --from=builder-back /opt/opencti/opencti-platform/opencti-graphql/config/ ./config/
COPY --from=builder-back /opt/opencti/opencti-platform/opencti-graphql/src/python/runtime/ ./src/python/runtime/
COPY --from=builder-back /opt/opencti/opencti-platform/opencti-graphql/static/ ./static/
COPY --from=builder-front /opt/opencti/opencti-platform/opencti-front/dist/ ./public/

ENV PYTHONUNBUFFERED="1"
ENV NODE_OPTIONS="--max_old_space_size=12288"
ENV NODE_ENV="production"

RUN <<EOT
  set -euxo pipefail

  install -m 0777 -d '/opt/opencti/logs'
  install -m 0777 -d '/opt/opencti/telemetry'
  install -m 0777 -d '/opt/opencti/.support'
EOT

VOLUME ["/opt/opencti/logs", "/opt/opencti/telemetry", "/opt/opencti/.support"]

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "build/back.mjs"]
