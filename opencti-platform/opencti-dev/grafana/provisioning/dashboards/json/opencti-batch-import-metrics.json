          "datasource": {
            "type": "prometheus",
            "uid": "opencti-prometheus"
          },
          "expr": "rate(opencti_bundles_lock_error_counter_total[5m])",
          "legendFormat": "lock_error",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencti-prometheus"
          },
          "expr": "rate(opencti_bundles_bad_gateway_error_counter_total[5m])",
          "legendFormat": "bad_gateway",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencti-prometheus"
          },
          "expr": "rate(opencti_bundles_timed_out_error_counter_total[5m])",
          "legendFormat": "timed_out",
          "refId": "G"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
