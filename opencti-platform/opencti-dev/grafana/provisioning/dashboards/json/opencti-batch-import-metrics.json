    {
      "type": "stat",
      "title": "Batching efficiency (% of batch-eligible items actually batched, last 15m)",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencti-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencti-prometheus"
          },
          "expr": "100 * sum(increase(opencti_worker_batch_items_total[15m])) / (sum(increase(opencti_worker_batch_items_total[15m])) + sum(increase(opencti_worker_batch_fallback_total[15m])) > 0)",
