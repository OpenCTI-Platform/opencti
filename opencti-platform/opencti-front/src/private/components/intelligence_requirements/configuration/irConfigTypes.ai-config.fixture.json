{
 "name": "Vulnérabilités activement exploitées sur notre SI et acteurs associés",
 "description": "Suivre les vulnérabilités activement exploitées qui touchent les systèmes du SI et les acteurs qui les exploitent.",
 "ir_question": "Parmi les vulnérabilités activement exploitées dans la nature, lesquelles affectent les systèmes de notre SI (produits, versions, composants exposés), et quels acteurs malveillants (groupes d'intrusion, campagnes) les exploitent actuellement, afin de prioriser les correctifs et les mesures de détection ?",
 "ir_priority": "high",
 "ir_status": "paused",
 "ir_thresholds": [
  50,
  80
 ],
 "ir_rescan_days": 30,
 "ir_kiqs": [
  {
   "id": "k1",
   "text": "Quelles vulnérabilités (CVE) présentes dans la plateforme sont marquées comme activement exploitées (catalogue CISA KEV, score EPSS élevé, étiquettes d'exploitation, rapports récents) ?",
   "criteria_ids": [
    "c-exploited"
   ]
  },
  {
   "id": "k2",
   "text": "Parmi ces vulnérabilités, lesquelles touchent des produits, versions ou composants (logiciels, systèmes) effectivement déployés ou exposés dans notre SI ?",
   "criteria_ids": [
    "c-system-vulns"
   ]
  },
  {
   "id": "k3",
   "text": "Quels groupes d'intrusion, acteurs de la menace et campagnes sont liés à l'exploitation de ces vulnérabilités (relations « exploite » / « cible ») ?",
   "criteria_ids": [
    "c-actors"
   ]
  },
  {
   "id": "k4",
   "text": "Quels logiciels malveillants, outils et techniques d'attaque (ATT&CK : accès initial, exécution, élévation de privilèges) sont utilisés avec ces vulnérabilités ?",
   "criteria_ids": [
    "c-arsenal",
    "c-vuln-malware"
   ]
  }
 ],
