{
  "name": "opencti-front",
  "version": "7.260904.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "relay": "relay-compiler relay.config.json",
    "dev": "yarn relay && vite",
    "dev:vite:debug": "yarn relay && vite --debug plugin-transform",
    "start": "yarn dev",
    "build": "yarn relay && vite build",
    "lint": "DEBUG=eslint:cli-engine TIMING=1 eslint --quiet --cache --config eslint.config.js src",
    "control": "yarn npm audit --environment production",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage.enabled",
    "check-ts": "tsc --noEmit",
    "i18n-checker": "node i18n-checker.js",
    "extract-translation": "node script/extract-i18n-keyword.js && node script/extract-label-keyword.js",
    "verify-translation": "node script/verify-translation.js",
    "sort-translation": "node script/sort-translation-files.js",
    "auto-translation:all": "node script/auto-translate.js && yarn sort-translation",
    "verify-licenses": "yarn license-checker-rseidelsohn --production --summary --onlyAllow '0BSD;Apache-2.0;BlueOak-1.0.0;BSD-2-Clause;BSD-3-Clause;CC-BY-3.0;CC-BY-4.0;CC0-1.0;ISC;LGPL-3.0;MIT;OFL-1.1;Python-2.0;Unlicense;UNLICENSED' --excludePackagesStartingWith 'opencti'",
    "test:e2e": "E2E_TEST=true yarn playwright test --workers=1 --retries=1 -x",
    "test:e2e:ui": "APP__BASE_PATH=/e2e E2E_TEST=true yarn playwright test --ui --workers=1",
    "generate-test-e2e": "yarn playwright codegen http://localhost:3000/",
    "test:e2e:coverage": "E2E_TEST=true E2E_COVERAGE=true yarn playwright test",
    "knip": "knip"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
